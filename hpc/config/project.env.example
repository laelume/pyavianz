# Copy to hpc/config/project.env and edit. Sourced by every Slurm script via
# hpc/slurm/env.sh. project.env is git-ignored so personal paths stay local.

# --- Rāpoi environment ------------------------------------------------------
# Scratch: 5 TB, NOT backed up. Home: 50 GB, backed up (keep code + configs there).
SCRATCH="/nfs/scratch/${USER}"
# Python virtualenv created by hpc/slurm/setup_env.sh
VENV="${SCRATCH}/venvs/avianz-hpc"
# Lmod modules loaded before activating the venv. Check names with
#   module spider Python    /    module spider CUDA
# (module names are case-sensitive). The PyTorch wheel from pip bundles its own
# CUDA runtime, so only Python (and its GCCcore) is needed here.
MODULES="GCCcore/12.3.0 Python/3.11.3-GCCcore-12.3.0"

# Caches (keep large downloads off the 50 GB home quota)
export HF_HOME="${SCRATCH}/.cache/huggingface"
export TORCH_HOME="${SCRATCH}/.cache/torch"
export PIP_CACHE_DIR="${SCRATCH}/.cache/pip"

# BirdCLEF RegNetY weights (the model-testing copy is a Git LFS pointer, not weights)
export AVIANZ_HPC_PRETRAINED="${SCRATCH}/pretrained/model_fold0.pth"

# --- Slurm ------------------------------------------------------------------
# Partitions: quicktest (5 h), parallel (10 days, CPU), gpu (24 h, 2x A100-40GB/node)
CPU_PARTITION="parallel"
GPU_PARTITION="gpu"
# Optional account/QoS flags, e.g. "--account=myproject"
SBATCH_EXTRA=""

# --- Data -------------------------------------------------------------------
# Annotated recordings used to build training data (space-separated roots)
TRAIN_AUDIO_ROOTS="${SCRATCH}/audio/annotated"
# Leave empty if .data files sit beside the audio; otherwise the folder holding them
ANNOTATION_ROOT=""
# Recordings to run inference over (space-separated roots)
INFER_AUDIO_ROOTS="${SCRATCH}/audio/unprocessed"

# Where datasets, models and inference results go
WORK="${SCRATCH}/avianz-hpc"

# --- Array sizes --------------------------------------------------------------
BUILD_SHARDS=32      # array tasks for build-dataset (CPU)
INFER_SHARDS=8       # array tasks for infer (each takes one GPU while running)
